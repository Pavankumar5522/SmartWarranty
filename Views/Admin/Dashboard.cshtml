@{
    ViewData["Title"] = "Admin Dashboard";
    var m = ViewBag.Metrics as Dictionary<string, int> ?? new Dictionary<string, int>();
    var customers = ViewBag.Customers as IEnumerable<SmartWarranty_2.Models.Customer> ?? Enumerable.Empty<SmartWarranty_2.Models.Customer>();
    var recentRequests = ViewBag.RecentRequests as IEnumerable<SmartWarranty_2.Models.ServiceRequest> ?? Enumerable.Empty<SmartWarranty_2.Models.ServiceRequest>();
}

<div class="page-header">
    <div>
        <div class="page-eyebrow">Administration</div>
        <h2>Operations overview</h2>
    </div>
    <a class="btn btn-outline-primary" asp-action="Reports">View reports</a>
</div>

<div class="row g-3 mb-4">
    @foreach (var item in new[] {
       new { Label = "Registered customers", Value = m.GetValueOrDefault("TotalCustomers") },
       new { Label = "Registered products", Value = m.GetValueOrDefault("TotalProducts") },
       new { Label = "Warranty records", Value = m.GetValueOrDefault("TotalWarranties") },
       new { Label = "Active warranties", Value = m.GetValueOrDefault("ActiveWarranties") },
       new { Label = "Expiring soon", Value = m.GetValueOrDefault("ExpiringSoonWarranties") },
       new { Label = "Expired warranties", Value = m.GetValueOrDefault("ExpiredWarranties") },
       new { Label = "Service requests", Value = m.GetValueOrDefault("TotalServiceRequests") },
       new { Label = "Pending / in progress", Value = m.GetValueOrDefault("PendingRequests") },
       new { Label = "Resolved", Value = m.GetValueOrDefault("ResolvedRequests") }
    })
    {
        <div class="col-md-4">
            <div class="card metric-card">
                <div class="card-body">
                    <div class="metric-label">@item.Label</div>
                    <div class="metric-value">@item.Value</div>
                    <div class="metric-accent"></div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card section-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Recent customers</h5>
                    <a asp-action="Customers" class="small text-decoration-none fw-bold">View all</a>
                </div>
                <ul class="list-clean">
                    @foreach (var customer in customers)
                    {
                        <li>
                            <div class="fw-bold">@customer.FirstName @customer.LastName</div>
                            <div class="small text-muted">@customer.Email</div>
                        </li>
                    }
                </ul>
                @if (!customers.Any()) { <div class="empty-state">No customers have registered yet.</div> }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card section-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Recent service requests</h5>
                    <a asp-action="ServiceRequests" class="small text-decoration-none fw-bold">Manage</a>
                </div>
                <ul class="list-clean">
                    @foreach (var req in recentRequests)
                    {
                        <li class="d-flex justify-content-between align-items-center gap-3">
                            <div>
                                <div class="fw-bold">@req.ServiceRequestCode</div>
                                <div class="small text-muted">@req.Product.Name</div>
                            </div>
                            <span class="status-badge status-pending">@req.Status</span>
                        </li>
                    }
                </ul>
                @if (!recentRequests.Any()) { <div class="empty-state">No service requests have been submitted yet.</div> }
            </div>
        </div>
    </div>
</div>
