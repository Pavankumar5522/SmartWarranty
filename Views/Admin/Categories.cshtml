@model IEnumerable<SmartWarranty_2.Models.ProductCategory>
@{
    ViewData["Title"] = "Categories";
}
<h2>Product Categories</h2>
<form asp-action="CreateCategory" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <div class="row g-2">
        <div class="col-md-6"><input name="Name" class="form-control" placeholder="Category name" required /></div>
        <div class="col-md-6"><input name="Description" class="form-control" placeholder="Description" /></div>
    </div>
    <button class="btn btn-primary mt-2" type="submit">Add Category</button>
</form>
<div class="card card-body mb-4">
    <h5>Import categories from CSV</h5>
    <p class="text-muted mb-3">Import up to 2,000 categories at once. Existing category details are preserved; duplicates or invalid rows must be fixed before anything is imported.</p>
    <form asp-action="PreviewCategoryImport" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-8">
                <label for="categoryCsvFile" class="form-label">Category CSV file (maximum 1 MB)</label>
                <input id="categoryCsvFile" name="csvFile" type="file" class="form-control" accept=".csv,text/csv" required />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button class="btn btn-outline-primary" type="submit">Preview import</button>
                <a asp-action="DownloadCategoryCsvTemplate" class="btn btn-outline-secondary">CSV template</a>
            </div>
        </div>
        <div class="form-text mt-2">Required column: Name. Optional column: Description.</div>
    </form>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No categories are in the catalog yet. Add one above or import a CSV.</div>
}
@foreach (var category in Model)
{
    <div class="card card-body mb-3">
        <form asp-action="UpdateCategory" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@category.Id" />
            <div class="row g-3">
                <div class="col-md-5">
                    <label for="CategoryName-@category.Id" class="form-label">Category name</label>
                    <input id="CategoryName-@category.Id" name="Name" value="@category.Name" class="form-control" maxlength="120" required />
                </div>
                <div class="col-md-5">
                    <label for="CategoryDescription-@category.Id" class="form-label">Description</label>
                    <input id="CategoryDescription-@category.Id" name="Description" value="@category.Description" class="form-control" maxlength="500" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-outline-primary w-100" type="submit">Save changes</button>
                </div>
            </div>
        </form>
        <form asp-action="DeleteCategory" method="post" class="mt-2" onsubmit="return confirm('Delete this category? Categories used by registered products cannot be deleted.');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@category.Id" />
            <button class="btn btn-outline-danger" type="submit">Delete category</button>
        </form>
    </div>
}
