@model SmartWarranty_2.ViewModels.WarrantyRegistrationViewModel
@{
    ViewData["Title"] = "Add Warranty";
    var products = ViewBag.Products as IEnumerable<SmartWarranty_2.Models.Product> ?? Enumerable.Empty<SmartWarranty_2.Models.Product>();
}
<div class="page-header">
    <div><div class="page-eyebrow">Coverage</div><h2>Add warranty coverage</h2></div>
    <a asp-action="Warranties" class="btn btn-outline-secondary">Cancel</a>
</div>
<div class="card"><div class="card-body p-4">
<form asp-action="AddWarranty" method="post" enctype="multipart/form-data" data-submit-feedback>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="ProductId" class="form-label"></label>
            <select asp-for="ProductId" class="form-select">
                @foreach (var product in products) { <option value="@product.Id">@product.Name</option> }
            </select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CoverageCategory" class="form-label"></label>
            <select asp-for="CoverageCategory" class="form-select" data-coverage-category data-extended-value="@((int)SmartWarranty_2.Models.WarrantyCoverageCategory.Extended)">
                <option value="@((int)SmartWarranty_2.Models.WarrantyCoverageCategory.Manufacturer)">Manufacturer warranty</option>
                <option value="@((int)SmartWarranty_2.Models.WarrantyCoverageCategory.Extended)">Extended warranty</option>
            </select>
            <span asp-validation-for="CoverageCategory" class="text-danger"></span>
            <div class="form-text">Only one manufacturer warranty is allowed per product. Extended warranties can be added separately.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DurationMonths" class="form-label"></label>
            <input asp-for="DurationMonths" class="form-control" />
            <span asp-validation-for="DurationMonths" class="text-danger"></span>
        </div>
        <div class="col-md-12">
            <label asp-for="WarrantyType" class="form-label"></label>
            <input asp-for="WarrantyType" class="form-control" />
            <span asp-validation-for="WarrantyType" class="text-danger"></span>
            <div class="form-text">The expiry date is calculated from the start date and duration.</div>
        </div>
        <div class="col-12" data-extended-invoice-fields>
            <label asp-for="ExtendedWarrantyInvoice" class="form-label"></label>
            <input asp-for="ExtendedWarrantyInvoice" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" />
            <span asp-validation-for="ExtendedWarrantyInvoice" class="text-danger"></span>
            <div class="form-text">Required for extended coverage. PDF and image files up to 5 MB are accepted.</div>
        </div>
    </div>
    <button class="btn btn-primary mt-3" type="submit" data-loading-text="Saving coverage...">Save coverage</button>
</form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
