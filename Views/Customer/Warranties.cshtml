@model IEnumerable<SmartWarranty_2.Models.Warranty>
@{
    ViewData["Title"] = "Warranty Management";
}
<div class="page-header">
    <div><div class="page-eyebrow">Coverage</div><h2>Warranty management</h2></div>
    <a class="btn btn-primary" asp-action="AddWarranty">+ Add warranty</a>
</div>
@if (!Model.Any())
{
    <div class="empty-state"><h5>No warranties yet</h5><p class="text-muted">Add a warranty to track its start and expiry dates.</p><a asp-action="AddWarranty" class="btn btn-primary">Add warranty</a></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Product</th><th>Coverage</th><th>Type</th><th>Start date</th><th>Expiry / time left</th><th>Status</th><th>Proof</th></tr></thead>
            <tbody>
                @foreach (var warranty in Model)
                {
                    var status = SmartWarranty_2.Services.WarrantyStatusService.GetStatus(warranty);
                    var statusClass = status == "Expired"
                        ? "status-expired"
                        : status == "Expiring Soon"
                            ? "status-expiring"
                            : status == "Not Started"
                                ? "status-pending"
                                : "status-active";
                    <tr>
                        <td class="fw-bold">@warranty.Product.Name</td>
                        <td>@(warranty.CoverageCategory == SmartWarranty_2.Models.WarrantyCoverageCategory.Extended ? "Extended" : "Manufacturer")</td>
                        <td>@warranty.WarrantyType</td>
                        <td>@warranty.StartDate.ToShortDateString()</td>
                        <td>
                            <div>@warranty.ExpiryDate.ToShortDateString()</div>
                            <div class="small text-muted">@SmartWarranty_2.Services.WarrantyStatusService.GetTimeRemainingLabel(warranty)</div>
                        </td>
                        <td><span class="status-badge @statusClass">@status</span></td>
                        <td>
                            @if (warranty.CoverageCategory == SmartWarranty_2.Models.WarrantyCoverageCategory.Extended)
                            {
                                var invoice = warranty.Documents.FirstOrDefault();
                                if (invoice != null)
                                {
                                    <a asp-action="DownloadDocument" asp-route-id="@invoice.Id">Invoice</a>
                                }
                                else
                                {
                                    <span class="text-muted">Legacy record</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
