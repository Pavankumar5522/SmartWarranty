@model SmartWarranty_2.ViewModels.CustomerLoginViewModel
@{
    ViewData["Title"] = "Customer Login";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card auth-card">
            <div class="card-body p-4">
                <div class="page-eyebrow mb-2">Customer account</div>
                <h3 class="mb-2">Welcome back</h3>
                <p class="text-muted mb-4">Sign in to view your products and warranty coverage.</p>
                <form asp-action="CustomerLogin" method="post" data-submit-feedback>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label"></label>
                        <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" />
                        <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" data-loading-text="Signing in...">Log in</button>
                </form>
                <p class="mt-3 mb-0 text-center">New customer? <a asp-action="CustomerRegister">Create an account</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}